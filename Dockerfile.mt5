FROM ubuntu:22.04

# Avoid prompts
ENV DEBIAN_FRONTEND=noninteractive

# Set environment variables early
ENV DISPLAY=:99
ENV WINEARCH=win64
ENV WINEPREFIX=/home/trader/.wine
ENV WINEDEBUG=-all

# Install WineHQ (Wine 11.0), Xvfb, wget and essential 2026-standard dependencies
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y \
    software-properties-common \
    wget \
    curl \
    gnupg2 \
    && mkdir -pm 755 /etc/apt/keyrings \
    && wget -O - https://dl.winehq.org/wine-builds/winehq.key | gpg --dearmor -o /etc/apt/keyrings/winehq-archive.key \
    && wget -NP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/ubuntu/dists/jammy/winehq-jammy.sources \
    && apt-get update && apt-get install -y --install-recommends \
    winehq-stable \
    winbind \
    cabextract \
    xvfb \
    x11-utils \
    dbus-x11 \
    libvulkan1 \
    libvulkan1:i386 \
    libasound2 \
    libpulse0 \
    libdbus-1-3 \
    libxcomposite1 \
    libxcursor1 \
    libxi6 \
    libxtst6 \
    libxrandr2 \
    libxrender1 \
    libxkbcommon0 \
    python3 \
    python3-pip \
    unzip \
    fonts-liberation \
    netcat \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m trader
USER trader
WORKDIR /home/trader

# Install latest winetricks from source
RUN wget -q -O /home/trader/winetricks https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks \
    && chmod +x /home/trader/winetricks

# 1. Robust initialization using Xvfb directly (avoiding xvfb-run issues in layers)
RUN Xvfb :99 -screen 0 1024x768x24 & \
    sleep 5 && \
    wine hostname && \
    wineserver -w && \
    /home/trader/winetricks -q corefonts && \
    wineserver -w && \
    /home/trader/winetricks -q d3dcompiler_47 && \
    wineserver -w && \
    wineboot -u && \
    wineserver -w

# 2. Setup MT5 and Python for Windows
RUN wget -O /home/trader/mt5setup.exe https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe && \
    wget -O /home/trader/python-setup.exe https://www.python.org/ftp/python/3.10.11/python-3.10.11-amd64.exe

# 3. Install MT5 and Python inside Wine
RUN Xvfb :99 -screen 0 1024x768x24 & \
    sleep 5 && \
    wine /home/trader/mt5setup.exe /silent && \
    wineserver -w && \
    wine /home/trader/python-setup.exe /quiet InstallAllUsers=1 PrependPath=1 && \
    wineserver -w

# 4. Install Python trading dependencies inside Wine
RUN Xvfb :99 -screen 0 1024x768x24 & \
    sleep 5 && \
    wine python -m pip install --upgrade pip && \
    wineserver -w && \
    wine python -m pip install MetaTrader5 mt5linux rpyc==4.1.5 && \
    wineserver -w

# Copy start script
COPY start_mt5.sh /home/trader/start_mt5.sh
# Note: Copying as root and changing owner is safer in some Docker setups, but we are USER trader.
# If copying as root, we would need to switch back.

USER root
RUN chown trader:trader /home/trader/start_mt5.sh && chmod +x /home/trader/start_mt5.sh
USER trader

# Expose bridge port
EXPOSE 8001

CMD ["/home/trader/start_mt5.sh"]
