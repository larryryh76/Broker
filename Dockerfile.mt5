FROM ubuntu:22.04

# Avoid prompts
ENV DEBIAN_FRONTEND=noninteractive

# Set environment variables early
ENV DISPLAY=:99
ENV WINEARCH=win64
ENV WINEPREFIX=/root/.wine

# Install Wine, Xvfb, wget and dependencies
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y \
    wine64 \
    wine32 \
    winbind \
    cabextract \
    xvfb \
    x11-utils \
    python3 \
    python3-pip \
    curl \
    wget \
    unzip \
    fonts-liberation \
    fonts-wine \
    && rm -rf /var/lib/apt/lists/*

# Install latest winetricks from source for better prefix handling
RUN wget -q -O /usr/local/bin/winetricks https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks \
    && chmod +x /usr/local/bin/winetricks

# 1. Initialize Wine prefix
RUN Xvfb :99 -screen 0 1024x768x16 & \
    sleep 5 && \
    wineboot --init && \
    wineserver -w

# 2. Install Gecko and Mono inside Wine
RUN Xvfb :99 -screen 0 1024x768x16 & \
    sleep 5 && \
    WINEPREFIX=/root/.wine winetricks -q gecko mono && \
    wineserver -w

# 3. Download MetaTrader 5 installer
RUN wget -O /mt5setup.exe https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe

# 4. Install MetaTrader 5
RUN Xvfb :99 -screen 0 1024x768x16 & \
    sleep 5 && \
    wine /mt5setup.exe /silent && \
    wineserver -w

# 5. Download Python for Windows
RUN wget -O /python-setup.exe https://www.python.org/ftp/python/3.10.11/python-3.10.11-amd64.exe

# 6. Install Python inside Wine
RUN Xvfb :99 -screen 0 1024x768x16 & \
    sleep 5 && \
    wine /python-setup.exe /quiet InstallAllUsers=1 PrependPath=1 && \
    wineserver -w

# 7. Install Python trading dependencies inside Wine
RUN Xvfb :99 -screen 0 1024x768x16 & \
    sleep 5 && \
    wine python -m pip install --upgrade pip && \
    wineserver -w

RUN Xvfb :99 -screen 0 1024x768x16 & \
    sleep 5 && \
    wine python -m pip install MetaTrader5 mt5linux rpyc==4.1.5 && \
    wineserver -w

# Copy start script
COPY start_mt5.sh /start_mt5.sh
RUN chmod +x /start_mt5.sh

# Expose bridge port
EXPOSE 8001

CMD ["/start_mt5.sh"]
