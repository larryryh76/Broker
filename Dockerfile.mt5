FROM ubuntu:22.04

# Avoid prompts
ENV DEBIAN_FRONTEND=noninteractive

# Essential system dependencies for Wine and MetaTrader 5
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y \
    software-properties-common \
    wget \
    curl \
    gnupg2 \
    ca-certificates \
    xvfb \
    x11-utils \
    dbus-x11 \
    libvulkan1 \
    libvulkan1:i386 \
    fonts-liberation \
    netcat \
    && mkdir -pm 755 /etc/apt/keyrings \
    && wget -O - https://dl.winehq.org/wine-builds/winehq.key | gpg --dearmor -o /etc/apt/keyrings/winehq-archive.key \
    && wget -NP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/ubuntu/dists/jammy/winehq-jammy.sources \
    && apt-get update && apt-get install -y --install-recommends \
    winehq-staging \
    && rm -rf /var/lib/apt/lists/*

# Set Wine environment variables
ENV WINEARCH=win64
ENV WINEPREFIX=/root/.wine
ENV WINEDEBUG=-all
ENV DISPLAY=:99

# Install winetricks
RUN wget -q -O /usr/local/bin/winetricks https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks \
    && chmod +x /usr/local/bin/winetricks

# Create workspace
WORKDIR /mt5

# Download installers
RUN wget -O /mt5setup.exe https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe && \
    wget -O /python-setup.exe https://www.python.org/ftp/python/3.10.11/python-3.10.11-amd64.exe

# 1. Initialize Wine and install Gecko/Mono
RUN xvfb-run -a wineboot --init && wineserver -w

# 2. Install MetaTrader 5
RUN xvfb-run -a wine /mt5setup.exe /silent && wineserver -w

# 3. Install Python for Windows
RUN xvfb-run -a wine /python-setup.exe /quiet InstallAllUsers=1 PrependPath=1 && wineserver -w

# 4. Install Bridge Dependencies
RUN xvfb-run -a wine python -m pip install --upgrade pip && \
    xvfb-run -a wine python -m pip install MetaTrader5 mt5linux rpyc==4.1.5 && \
    wineserver -w

# Start script
COPY start_mt5.sh /start_mt5.sh
RUN chmod +x /start_mt5.sh

EXPOSE 8001
CMD ["/start_mt5.sh"]
